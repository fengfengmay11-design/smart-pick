# 复制本文件为 .env 后填入你的真实 Key（.env 已在 .gitignore，不会上传）
# ── DeepSeek（推荐：国内直连，新用户送额度）──
LLM_API_KEY=sk-你的key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── 换成通义千问 ──
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ── 换成 Kimi ──
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# ── 换成 OpenAI ──
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ── 京东联盟（价格刷新 / 商品查询）──
# 注册地址：https://union.jd.com/openplatform/
# 创建应用后拿到 app_key 和 app_secret，填入下方
JD_APP_KEY=你的app_key
JD_APP_SECRET=你的app_secret
JD_SITE_ID=你的site_id
